{
  "name": "open-carrusel",
  "version": "0.1.0",
  "description": "CLI-first Instagram carousel editor. Compose slides from a brief, correct them by hand, optionally use AI. Export PNGs at exact Instagram dimensions.",
  "license": "MIT",
  "private": true,
  "bin": {
    "oc": "scripts/oc.mjs"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AXLAAF/Open-Carrusel"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "doctor": "node scripts/doctor.mjs",
    "oc": "node scripts/oc.mjs",
    "cli": "node scripts/oc.mjs",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "archiver": "^7.0.1",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.8.0",
    "next": "16.2.11",
    "puppeteer": "^24.40.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/estree": "^1.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "undici": ">=6.27.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
